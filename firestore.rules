rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User lookup documents
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Family document - only authenticated parent can read/write their own family
    match /families/{familyId} {
      allow read: if request.auth != null && request.auth.uid == familyId;
      allow create: if request.auth != null && request.auth.uid == familyId;
      allow update: if request.auth != null && request.auth.uid == familyId;

      // Logs - parent can read, Cloud Functions write (via admin SDK)
      match /logs/{logId} {
        allow read: if request.auth != null && request.auth.uid == familyId;
        allow write: if false;
      }

      // Events (monitoring interruptions) - parent can read
      match /events/{eventId} {
        allow read: if request.auth != null && request.auth.uid == familyId;
        allow write: if false;
      }

      // Domain overrides - parent can read/write
      match /overrides/{domain} {
        allow read, write: if request.auth != null && request.auth.uid == familyId;
      }
    }

    // Devices - parent can read their own + create new devices for their family
    match /devices/{deviceId} {
      allow read: if request.auth != null
        && resource.data.familyId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.familyId == request.auth.uid;
      allow update, delete: if false;
    }

    // Pairing codes - parent can create from dashboard
    match /pairingCodes/{code} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
  }
}
